# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ya está en .gitignore).

# --- Supabase (schema "farmalem" en el proyecto "lemus-store") ---
# URL: Supabase → tu proyecto → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://iatyvxljzrcdfmmtesig.supabase.co
# Settings → API → service_role key (secreta — nunca la publiques ni la pongas en NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago ---
# Tus integraciones → [tu app] → Credenciales de producción → Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones → [tu app] → Webhooks → Firma secreta
MERCADOPAGO_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (aviso automático por pedido pagado) ---
# Meta for Developers → tu app → WhatsApp → Configuración de la API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Tu número, el que debe RECIBIR el aviso. Formato 521XXXXXXXXXX, sin "+".
WHATSAPP_NOTIFY_NUMBER=
# Nombre de la plantilla ya aprobada por Meta (ver README). Puedes dejarlo
# vacío si usas el nombre por default: nuevo_pedido_farmalem
WHATSAPP_TEMPLATE_NAME=
# Plantilla para el aviso de "corte de caja capturado" en /admin (ver README).
# Puedes dejarlo vacío si usas el nombre por default: corte_capturado_farmalem
WHATSAPP_CUT_TEMPLATE_NAME=

# --- Panel de administración (/admin) ---
# La contraseña que tú elijas para entrar al panel de pedidos.
ADMIN_PASSWORD=
# Cadena aleatoria larga solo para firmar la sesión — genera una con:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Sitio ---
# Déjalo vacío en desarrollo (usa http://localhost:3000 por default).
# En producción, ponlo con tu dominio real, ej: https://farmalem.mx
NEXT_PUBLIC_SITE_URL=
