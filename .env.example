# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ya está en .gitignore).

# --- Supabase (schema "farmalem" en el proyecto "lemus-store") ---
# URL: Supabase → tu proyecto → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://iatyvxljzrcdfmmtesig.supabase.co
# Settings → API → service_role key (secreta — nunca la publiques ni la pongas en NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → anon/public key. Sí está pensada para exponerse al
# navegador (por eso NEXT_PUBLIC_) — la usa Nueva recepción para llamar
# directo a la Edge Function que lee los tickets (ver más abajo).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mercado Pago ---
# Tus integraciones → [tu app] → Credenciales de producción → Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones → [tu app] → Webhooks → Firma secreta
MERCADOPAGO_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (aviso automático por pedido pagado) ---
# Meta for Developers → tu app → WhatsApp → Configuración de la API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Tu número, el que debe RECIBIR el aviso. Formato 521XXXXXXXXXX, sin "+".
WHATSAPP_NOTIFY_NUMBER=
# Nombre de la plantilla ya aprobada por Meta (ver README). Puedes dejarlo
# vacío si usas el nombre por default: nuevo_pedido_farmalem
WHATSAPP_TEMPLATE_NAME=
# Plantilla para el aviso de "corte de caja capturado" en /admin (ver README).
# Puedes dejarlo vacío si usas el nombre por default: corte_capturado_farmalem
WHATSAPP_CUT_TEMPLATE_NAME=
# Plantilla para el aviso de "checada" (entrada/salida en el reloj checador)
# en /admin (ver README). Vacío = checada_farmalem
WHATSAPP_PUNCH_TEMPLATE_NAME=

# --- Panel de administración (/admin) ---
# La contraseña que tú elijas para entrar al panel de pedidos.
ADMIN_PASSWORD=
# Cadena aleatoria larga solo para firmar la sesión — genera una con:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Recepción de mercancía (lectura de tickets con IA) ---
# La lectura corre en una Edge Function de Supabase (supabase/functions/parse-ticket),
# no aquí — las funciones de Netlify tienen un límite de 10-26s y la lectura
# tarda 30-60s. No hay nada que configurar en este .env para eso: en vez de
# eso, en el proyecto de Supabase (Edge Functions → parse-ticket → Secrets)
# hay que poner ANTHROPIC_API_KEY con una llave de console.anthropic.com.

# --- Protección contra "version skew" en despliegues (Netlify) ---
# Esta NO va en .env.local — se configura directo en Netlify (Site
# configuration → Environment variables), porque es Netlify quien la lee al
# construir, no la propia app. Sin ella, si alguien está a media captura de
# un corte justo cuando se publica una actualización, su página se queda con
# código viejo que ya no coincide con el servidor y le puede fallar al
# guardar. Con ella, cada sesión ya abierta se queda pegada a la versión con
# la que cargó — sigue funcionando sin problema — y solo pasa a la versión
# nueva cuando esa persona vuelva a cargar la página desde cero (otro día,
# al volver a entrar, etc.), sin que nadie tenga que actualizar a la fuerza.
#   NETLIFY_NEXT_SKEW_PROTECTION=true

# --- Sitio ---
# Déjalo vacío en desarrollo (usa http://localhost:3000 por default).
# En producción, ponlo con tu dominio real, ej: https://farmalem.mx
NEXT_PUBLIC_SITE_URL=
